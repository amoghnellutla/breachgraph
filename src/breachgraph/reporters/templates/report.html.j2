    });
  });
  var W = PAD * 2 + (vertical ? (maxRows - 1) * CR + NW : (cols.length - 1) * AX + NW);
  var H = PAD * 2 + (vertical ? (cols.length - 1) * AX + NH : (maxRows - 1) * CR + NH);

  function el(tag, attrs, parent) {
    var x = document.createElementNS(SVG, tag);
    Object.keys(attrs).forEach(function (k) { x.setAttribute(k, attrs[k]); });
    if (parent) parent.appendChild(x);
    return x;
  }
  var svg = el("svg", { role: "img", "aria-label": "Attack graph: " + data.paths.length + " path(s) from the internet to high-value assets" });
  var view = el("g", { id: "view" }, svg);
  var gEdges = el("g", {}, view), gLabels = el("g", {}, view), gNodes = el("g", {}, view);
  var runner = el("circle", { id: "runner", r: 5, class: "idle" }, view);
