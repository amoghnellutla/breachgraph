<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ target_name }} · breachgraph</title>
<style>
/* One signal color means one thing: an attacker needs a real weakness here. The rest is neutral. */
:root {
  color-scheme: light;
  --bg: #f3f4f5; --pane: #fbfbfc; --raised: #fff; --sunken: #eceef0;
  --ink: #14171a; --ink-2: #474d55; --muted: #6d747d; --line: #dfe2e5; --line-2: #c7ccd2;
  --signal: #d93a1f; --signal-soft: #fbe9e4; --amber: #a86a08; --ok: #1f7d4d; --ok-soft: #e2f2e9;
  --pop: 0 1px 2px rgba(20, 23, 26, .08), 0 12px 32px -12px rgba(20, 23, 26, .28);
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  --mono: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
  --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px; --s5: 24px; --s6: 32px; --s7: 48px;
  --r: 6px; --ease: cubic-bezier(.2, .8, .2, 1);
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --bg: #0d0f11; --pane: #121518; --raised: #191d21; --sunken: #0a0c0e;
    --ink: #e9ebee; --ink-2: #b0b6be; --muted: #7f868f; --line: #23282d; --line-2: #343a41;
    --signal: #ff6647; --signal-soft: #331712; --amber: #e0a43c; --ok: #4cc085; --ok-soft: #11291d;
    --pop: 0 1px 2px rgba(0, 0, 0, .5), 0 14px 36px -12px rgba(0, 0, 0, .8);
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0d0f11; --pane: #121518; --raised: #191d21; --sunken: #0a0c0e;
  --ink: #e9ebee; --ink-2: #b0b6be; --muted: #7f868f; --line: #23282d; --line-2: #343a41;
  --signal: #ff6647; --signal-soft: #331712; --amber: #e0a43c; --ok: #4cc085; --ok-soft: #11291d;
  --pop: 0 1px 2px rgba(0, 0, 0, .5), 0 14px 36px -12px rgba(0, 0, 0, .8);
}

* { box-sizing: border-box; }
html { background: var(--bg); -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.5 var(--sans); -webkit-font-smoothing: antialiased; }
h1, h2, h3, p, ul, dl, dd { margin: 0; padding: 0; }
ul { list-style: none; }
a { color: inherit; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
a:hover { text-decoration-color: currentColor; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
code, pre, .mono { font-family: var(--mono); font-size: 12.5px; }
code { overflow-wrap: anywhere; }
pre { background: var(--sunken); padding: var(--s3); border-radius: var(--r); overflow-x: auto; white-space: pre-wrap; line-height: 1.5; margin: var(--s2) 0; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
.wrap { max-width: 1560px; margin: 0 auto; padding: 0 var(--s5); }
.muted { color: var(--muted); }
.P1 { color: var(--signal); } .P2 { color: var(--amber); } .P3 { color: var(--ink-2); } .P4 { color: var(--muted); }

/* top bar */
.bar { display: flex; align-items: center; gap: var(--s3); height: 48px; border-bottom: 1px solid var(--line); background: var(--pane); padding: 0 var(--s5); font-size: 13px; }
.mark { display: inline-flex; align-items: center; gap: var(--s2); font-weight: 600; letter-spacing: -.01em; text-decoration: none; }
.crumb { color: var(--muted); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.spacer { flex: 1; }
.barbtn { height: 28px; padding: 0 var(--s3); border-radius: var(--r); color: var(--ink-2); display: inline-flex; align-items: center; text-decoration: none; white-space: nowrap; transition: background-color .15s; }
.barbtn:hover { background: var(--sunken); color: var(--ink); }
.barbtn:active { transform: translateY(1px); }

/* headline */
.head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s4) var(--s7); align-items: end; padding: var(--s5) 0 var(--s4); }
h1 { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.15; font-weight: 600; letter-spacing: -.03em; max-width: 40ch; }
h1 em { font-style: normal; color: var(--signal); }
h1.clear em { color: var(--ok); }
.sub { margin-top: var(--s2); color: var(--ink-2); max-width: 66ch; }
.gate { display: flex; flex-wrap: wrap; gap: 2px var(--s3); margin-top: var(--s2); font-size: 12.5px; color: var(--muted); }
.gate b { font-weight: 600; color: var(--ink); }
.gate b.failed { color: var(--signal); } .gate b.incomplete { color: var(--amber); } .gate b.passed { color: var(--ok); }
.stats { display: grid; grid-auto-flow: column; gap: var(--s6); }
.stats div { min-width: 44px; }
.stats dt { font-size: 12px; color: var(--muted); }
.stats dd { font: 500 22px/1.3 var(--mono); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.intro { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); align-items: center; justify-content: space-between; padding: 0 0 var(--s3); color: var(--ink-2); font-size: 13.5px; }
.intro .cta { display: inline-flex; align-items: center; gap: var(--s2); }
.copy { font-family: var(--mono); font-size: 12.5px; padding: 3px var(--s2); border: 1px solid var(--line-2); border-radius: var(--r); background: var(--raised); transition: border-color .15s; }
.copy:hover { border-color: var(--ink-2); }
.copy:active { transform: translateY(1px); }
.change { padding: var(--s3) var(--s4); border: 1px solid var(--line); border-radius: var(--r); background: var(--pane); margin-bottom: var(--s4); }
.change h2 { font-size: 14px; font-weight: 600; }

/* the workbench: three panes that read as one instrument */
.bench { display: grid; grid-template-columns: 264px minmax(0, 1fr) 348px; height: clamp(600px, calc(100vh - 72px), 900px); background: var(--pane); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
.pane + .pane { border-left: 1px solid var(--line); }
.pane > h2, .panelabel { flex: none; font-size: 12px; font-weight: 600; color: var(--muted); padding: var(--s3) var(--s4) var(--s2); display: flex; justify-content: space-between; gap: var(--s2); }
.scroll { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; }

/* paths and fixes */
.row { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 0 var(--s2); width: 100%; text-align: left; padding: var(--s2) var(--s4); position: relative; transition: background-color .12s; }
.row:hover { background: var(--sunken); }
.row:active { background: var(--line); }
.row:focus-visible { outline-offset: -2px; }
.row[aria-pressed="true"] { background: var(--sunken); box-shadow: inset 2px 0 0 var(--ink); }
.row .n { font: 12px/20px var(--mono); color: var(--muted); }
.row .t { font-weight: 500; overflow-wrap: anywhere; line-height: 20px; }
.row .m { grid-column: 2; font-size: 12px; color: var(--muted); }
.row .m b { font-weight: 500; color: var(--signal); }
.row .m .low { color: var(--amber); }
.row.closed .t { text-decoration: line-through; color: var(--muted); }
.row.closed .m b { color: var(--muted); }
.divider { height: 1px; background: var(--line); margin: var(--s3) 0 0; }
.fix { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 0 var(--s2); padding: var(--s2) var(--s4); cursor: pointer; transition: background-color .12s; }
.fix:hover { background: var(--sunken); }
.fix input { appearance: none; width: 15px; height: 15px; margin: 3px 0 0; border: 1.5px solid var(--line-2); border-radius: 4px; background: var(--raised); cursor: pointer; display: grid; place-content: center; transition: border-color .12s, background-color .12s; }
.fix:hover input { border-color: var(--ink-2); }
.fix input:checked { background: var(--ok); border-color: var(--ok); }
.fix input:checked::after { content: ""; width: 8px; height: 4px; border: solid var(--pane); border-width: 0 0 1.5px 1.5px; transform: rotate(-45deg) translate(1px, -1px); }
.fix .t { line-height: 20px; overflow-wrap: anywhere; }
.fix .m { grid-column: 2; font-size: 12px; color: var(--muted); }
.fix code { grid-column: 2; font-size: 11.5px; font-weight: 400; color: var(--muted); }

/* graph */
.stage { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--sunken); touch-action: pan-y; cursor: grab; }
.stage.drag { cursor: grabbing; }
.stage svg { display: block; width: 100%; height: 100%; user-select: none; }
#view { transform-origin: 0 0; }
#view.glide { transition: transform .55s var(--ease); }
.tools { position: absolute; right: var(--s3); bottom: var(--s3); display: flex; background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--pop); }
.tools button { width: 30px; height: 28px; color: var(--ink-2); font-size: 13px; transition: background-color .12s; }
.tools button + button { border-left: 1px solid var(--line); }
.tools .fit { width: 40px; font-size: 12px; }
.tools button:hover { background: var(--sunken); color: var(--ink); }
.tools button:active { transform: translateY(1px); }
.key { position: absolute; left: var(--s3); bottom: var(--s3); display: flex; gap: var(--s3); font-size: 12px; color: var(--muted); pointer-events: none; }
.key span::before { content: ""; display: inline-block; width: 14px; height: 2px; margin-right: 6px; vertical-align: middle; background: var(--line-2); }
.key span.v::before { background: var(--signal); }
.edge { fill: none; stroke: var(--line-2); stroke-width: 1.5; transition: opacity .25s, stroke .2s; }
.edge.weapon { stroke: var(--signal); stroke-width: 1.75; }
.edge.on { stroke: var(--ink-2); stroke-width: 2; }
.edge.weapon.on { stroke: var(--signal); stroke-width: 2.25; }
.hit { fill: none; stroke: transparent; stroke-width: 14; cursor: help; }
.lbl rect { fill: var(--signal-soft); stroke: none; }
.lbl text { fill: var(--signal); font: 500 10.5px var(--mono); }
.node { cursor: pointer; transition: opacity .25s; }
.node .card { fill: var(--raised); stroke: var(--line-2); stroke-width: 1; transition: stroke .12s; }
.node:hover .card { stroke: var(--ink-2); }
.node.on .card { stroke: var(--ink-2); stroke-width: 1.25; }
.node.now .card { stroke: var(--ink); stroke-width: 2; }
.node.sel .card { stroke: var(--ink); stroke-width: 2; }
.node.jewel .card { stroke-width: 1.5; stroke-dasharray: none; }
.node:focus-visible { outline: none; }
.node:focus-visible .card { stroke: var(--ink); stroke-width: 2; }
.node:active .card { stroke-width: 2.5; }
.node .glyph { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
.node.jewel .glyph { stroke: var(--ink); }
.node .name { fill: var(--ink); font: 500 12.5px var(--sans); }
.node .kind { fill: var(--muted); font: 11px var(--sans); }
.node .dot { fill: var(--signal); }
.dim { opacity: .22; }
.gone { opacity: .1; }
.cut { stroke-dasharray: 3 5; }
#runner { fill: var(--signal); }
#runner.idle { opacity: 0; }

/* trace */
.tracehead { flex: none; padding: var(--s3) var(--s4); border-bottom: 1px solid var(--line); }
.tracehead h3 { font-size: 15px; font-weight: 600; letter-spacing: -.01em; overflow-wrap: anywhere; line-height: 1.3; }
.tracehead .m { margin-top: 2px; font-size: 12px; color: var(--muted); }
.ctrls { display: flex; gap: var(--s1); margin-top: var(--s2); align-items: center; }
.ctl { height: 26px; min-width: 28px; padding: 0 var(--s2); border: 1px solid var(--line-2); border-radius: var(--r); background: var(--raised); font-size: 12.5px; transition: border-color .12s; }
.ctl:hover { border-color: var(--ink-2); }
.ctl:active { transform: translateY(1px); }
.ctl:disabled { opacity: .4; cursor: default; }
.ctrls .hint { margin-left: auto; font-size: 11.5px; color: var(--muted); }
kbd { font: 11px var(--mono); padding: 0 4px; border: 1px solid var(--line-2); border-radius: 3px; }
.trace { padding: var(--s3) var(--s4) var(--s4); }
.hop { position: relative; padding: 0 0 var(--s4) 22px; cursor: pointer; }
.hop::before { content: ""; position: absolute; left: 4px; top: 16px; bottom: -4px; width: 1px; background: var(--line-2); }
.hop:last-child { padding-bottom: 0; }
.hop:last-child::before { display: none; }
.hop::after { content: ""; position: absolute; left: 0; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--pane); border: 1.5px solid var(--line-2); transition: transform .2s var(--ease), background-color .15s, border-color .15s; }
.hop.vuln::before { background: var(--signal); }
.hop.arrived::after { border-color: var(--ink-2); background: var(--ink-2); }
.hop.now::after { border-color: var(--ink); background: var(--ink); transform: scale(1.25); }
.hop.jewel::after { border-radius: 2px; }
.hop .h { font-weight: 500; overflow-wrap: anywhere; line-height: 20px; }
.hop .k { font-size: 12px; color: var(--muted); }
.hop:hover .h { text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; }
.how { margin-top: var(--s2); font-size: 12.5px; color: var(--ink-2); }
.weak { margin-top: var(--s2); padding: var(--s2) var(--s3); background: var(--signal-soft); border-radius: var(--r); font-size: 12.5px; }
.weak .c { color: var(--signal); font-weight: 600; }
.weak code { display: block; margin-top: 2px; font-size: 11.5px; color: var(--ink-2); }
.weak.done { background: var(--ok-soft); }
.weak.done .c { color: var(--ok); }
.tags { margin-top: var(--s1); font: 11px var(--mono); color: var(--muted); }
.tags a { text-decoration: none; }
.tags a:hover { color: var(--ink); text-decoration: underline; }
.act { margin-top: var(--s2); font-size: 12.5px; font-weight: 500; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
.act:hover { text-decoration-color: currentColor; }
.closednote { padding: var(--s2) var(--s3); margin-bottom: var(--s3); background: var(--ok-soft); color: var(--ok); border-radius: var(--r); font-size: 12.5px; font-weight: 500; }
.info dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px var(--s3); font-size: 13px; }
.info dt { color: var(--muted); }
.info dd { overflow-wrap: anywhere; }
.info h4 { margin: var(--s4) 0 var(--s1); font-size: 12px; font-weight: 600; color: var(--muted); }
.info li { font-size: 13px; padding: 2px 0; overflow-wrap: anywhere; }
.tip { position: absolute; z-index: 5; pointer-events: none; max-width: 280px; background: var(--raised); border: 1px solid var(--line-2); border-radius: var(--r); padding: 6px var(--s2); font-size: 12px; line-height: 1.4; box-shadow: var(--pop); opacity: 0; transition: opacity .1s; }
.tip.on { opacity: 1; }
.tip b { display: block; font-weight: 600; }

/* lower tabs */
.tabs { display: flex; gap: var(--s5); margin-top: var(--s6); border-bottom: 1px solid var(--line); overflow-x: auto; }
.tabs button { padding: var(--s2) 0; color: var(--muted); font-weight: 500; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color .12s; }
.tabs button:hover { color: var(--ink); }
.tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--ink); }
.tabs .c { font: 12px var(--mono); color: var(--muted); margin-left: 4px; }
.tab { padding: var(--s4) 0 var(--s7); }
.tab > h2 { font-size: 15px; font-weight: 600; margin-bottom: var(--s2); }
.js .tab > h2 { display: none; }
.lead { color: var(--ink-2); max-width: 72ch; margin-bottom: var(--s3); }
.filters { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; margin-bottom: var(--s3); }
.filters input[type=search], .filters select { height: 32px; padding: 0 var(--s2); border: 1px solid var(--line-2); border-radius: var(--r); background: var(--raised); color: var(--ink); font: inherit; font-size: 13px; transition: border-color .12s; }
.filters input[type=search]:hover, .filters select:hover { border-color: var(--ink-2); }
.filters input[type=search] { flex: 1 1 240px; }
.filters label { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; color: var(--ink-2); cursor: pointer; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 12px; font-weight: 500; color: var(--muted); padding: var(--s2) var(--s3); border-bottom: 1px solid var(--line-2); white-space: nowrap; }
td { padding: var(--s2) var(--s3); border-bottom: 1px solid var(--line); vertical-align: top; }
tr.finding { cursor: pointer; transition: background-color .1s; }
tr.finding:hover td { background: var(--sunken); }
tr.finding:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
tr.finding td:first-child { font-family: var(--mono); font-size: 12.5px; white-space: nowrap; }
tr.detail td { background: var(--pane); padding: var(--s3); }
.flags { font-size: 12px; color: var(--muted); }
.flags b { font-weight: 500; color: var(--signal); }
.mloc { display: none; font-size: 11.5px; color: var(--muted); overflow-wrap: anywhere; }
.loc { word-break: break-all; font-size: 12.5px; }
dl.kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px var(--s4); margin-bottom: var(--s2); font-size: 13px; }
dl.kv dt { color: var(--muted); }
dl.kv dd { overflow-wrap: anywhere; }
.detail p { margin: var(--s2) 0; max-width: 90ch; }
.ai { padding: var(--s2) var(--s3); background: var(--sunken); border-radius: var(--r); }
.list li { padding: var(--s2) 0; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
.list .a { color: var(--muted); font-size: 12.5px; display: block; }
.textpath { padding: var(--s3) 0; border-bottom: 1px solid var(--line); }
.textpath h3 { font-size: 14px; font-weight: 600; }
.textpath ol { margin: var(--s1) 0 0; padding-left: 20px; }
.textpath small { display: block; color: var(--muted); }
.textpath .v { color: var(--signal); }
footer { padding: var(--s4) 0 var(--s6); color: var(--muted); font-size: 12.5px; border-top: 1px solid var(--line); }
@media (max-width: 1180px) {
  .bench { grid-template-columns: 248px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; height: auto; }
  .bench .pane.left, .bench .pane.mid { height: 520px; }
  .bench .pane.right { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); }
  .bench .pane.right .scroll { overflow: visible; }
}
@media (max-width: 760px) {
  .wrap { padding: 0 var(--s4); }
  .bar { padding: 0 var(--s4); }
  .head { grid-template-columns: minmax(0, 1fr); padding-top: var(--s5); }
  .stats { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  .bench { grid-template-columns: minmax(0, 1fr); }
  .bench .pane.left { height: auto; }
  .bench .pane.left .scroll { overflow: visible; }
  .bench .pane.mid { height: 460px; border-left: 0; border-top: 1px solid var(--line); }
  .ctrls .hint, .key { display: none; }
  th:nth-child(3), td:nth-child(3), th:nth-child(4), td:nth-child(4) { display: none; }
  .mloc { display: block !important; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
{% set ag = result.attack_graph %}
{% set path_count = ag.paths | length if ag else 0 %}
{% set jewels = ag.paths | map(attribute="target") | unique | list if ag else [] %}
{% set first_fix = ag.choke_points[0] if ag and ag.choke_points else none %}
<body>
<div class="bar">
  <a class="mark" href="{{ project_url }}" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="3.5" cy="9" r="2"/><circle cx="14.5" cy="3.5" r="2"/><circle cx="14.5" cy="14.5" r="2" fill="currentColor"/><path d="M5.3 8.1 12.7 4.4M5.3 9.9l7.4 3.7"/></svg>
    breachgraph
  </a>
  <span class="crumb">{{ target_name }}</span>
  <span class="spacer"></span>
  <button class="barbtn" id="theme" type="button" hidden>Theme</button>
  {% if demo %}<a class="barbtn" href="{{ project_url }}" rel="noopener">GitHub</a>{% endif %}
</div>
<main class="wrap">
  <section class="head">
    <div>
      {% if path_count %}
      <h1 id="headline"><em>{{ path_count }} attack path{{ "" if path_count == 1 else "s" }}</em> reach{{ "es" if path_count == 1 else "" }} {{ jewels | length }} high-value asset{{ "" if jewels | length == 1 else "s" }}</h1>
      {% if first_fix %}<p class="sub" id="subhead">Start here: {{ first_fix.title | replace("`", "") }} breaks {{ first_fix.paths_cut }} of them.</p>{% endif %}
      {% elif result.gate.verdict == "incomplete" %}
      <h1>No attack path found, <em>but the scan is incomplete</em></h1>
      {% else %}
      <h1 class="clear"><em>No attack path</em> reaches a high-value asset</h1>
      {% endif %}
      <div class="gate">
        <span>Gate <b class="{{ result.gate.verdict }}">{{ result.gate.verdict }}</b></span>
        {% if result.gate.incomplete %}<span>{{ result.gate.incomplete | join("; ") }}</span>{% endif %}
        {% if result.gate.reasons %}<span>{{ result.gate.reasons | join("; ") }}</span>{% endif %}
        <span>{{ result.started_at.strftime("%Y-%m-%d %H:%M UTC") }}</span>
        <span>breachgraph {{ result.breachgraph_version }}</span>
        {% if result.baseline_used %}<span>Compared with a baseline: only new findings and paths gate</span>{% endif %}
        {% if ag and ag.coverage %}<span style="flex-basis: 100%">{{ ag.coverage.line() }}</span>{% endif %}
      </div>
    </div>
    <dl class="stats">
      <div><dt>Blocking</dt><dd>{{ gating }}</dd></div>
      <div><dt>P1</dt><dd class="P1">{{ open_by_prio.get("P1", 0) }}</dd></div>
      <div><dt>P2</dt><dd class="P2">{{ open_by_prio.get("P2", 0) }}</dd></div>
      <div><dt>P3</dt><dd>{{ open_by_prio.get("P3", 0) }}</dd></div>
      <div><dt>P4</dt><dd>{{ open_by_prio.get("P4", 0) }}</dd></div>
      <div><dt>Suppressed</dt><dd>{{ suppressed }}</dd></div>
    </dl>
  </section>

  {% if demo %}
  <p class="intro">
    <span>This is a real scan of a small, deliberately vulnerable platform. Pick a path, step through it, then mark a fix and watch what closes.</span>
    <span class="cta"><button class="copy" type="button" id="copy" data-text="pip install breachgraph">pip install breachgraph</button></span>
  </p>
  {% endif %}

  {% if changes %}
  {% set opened, closed = changes %}
  <section class="change">
    {% if opened %}<h2>This change opens {{ opened|length }} new attack path(s)</h2>
    <ul>{% for p in opened %}<li>Internet{% for s in p.steps %} → {{ s.dst }}{% endfor %}</li>{% endfor %}</ul>{% endif %}
    {% if closed %}<h2>This change closes {{ closed|length }} attack path(s)</h2>
    <ul>{% for p in closed %}<li><s>Internet{% for s in p.steps %} → {{ s.dst }}{% endfor %}</s></li>{% endfor %}</ul>{% endif %}
    {% if not opened and not closed %}<p>No change to attack paths compared with the base report.</p>{% endif %}
  </section>
  {% endif %}

  {% if explorer %}
  <section class="bench" id="explorer" aria-label="Attack path explorer" hidden>
    <div class="pane left">
      <div class="scroll">
        <h2 class="panelabel"><span>Attack paths</span><span class="mono" id="counter" aria-live="polite"></span></h2>
        <div id="paths"></div>
        <div id="fixes"></div>
      </div>
    </div>
    <div class="pane mid">
      <div class="stage" id="stage">
        <div class="tip" id="tip" role="tooltip"></div>
        <div class="key" aria-hidden="true"><span>access</span><span class="v">needs a real weakness</span></div>
        <div class="tools">
          <button type="button" id="zoom-out" aria-label="Zoom out">−</button>
          <button type="button" id="zoom-fit" class="fit" aria-label="Fit the graph">Fit</button>
          <button type="button" id="zoom-in" aria-label="Zoom in">+</button>
        </div>
      </div>
    </div>
    <div class="pane right" id="inspector" aria-label="Selected path"></div>
  </section>
  {% endif %}

  <nav class="tabs" id="tabs" role="tablist" aria-label="Report sections" hidden>
    <button type="button" role="tab" data-tab="t-findings">Findings<span class="c">{{ result.urgent() | length }}/{{ result.findings | length }}</span></button>
    {% if ag and ag.exposures %}<button type="button" role="tab" data-tab="t-exposures">One bug away<span class="c">{{ ag.exposures | length }}</span></button>{% endif %}
    {% if ag and ag.skipped %}<button type="button" role="tab" data-tab="t-blind">Blind spots<span class="c">{{ ag.skipped | length }}</span></button>{% endif %}
    <button type="button" role="tab" data-tab="t-scanners">Scanners<span class="c">{{ result.tools | length }}</span></button>
    {% if ag and ag.paths %}<button type="button" role="tab" data-tab="t-text">Paths as text</button>{% endif %}
  </nav>

  <section class="tab" id="t-findings">
    <h2>Findings</h2>
    <div class="filters">
      <input id="q" type="search" placeholder="Filter by text, CVE, CWE or path" aria-label="Filter">
      <select id="prio" aria-label="Priority"><option value="">Any priority</option>{% for p in ["P1","P2","P3","P4"] %}<option>{{ p }}</option>{% endfor %}</select>
      <select id="tool" aria-label="Tool"><option value="">Any tool</option>{% for t in tools %}<option>{{ t }}</option>{% endfor %}</select>
      <select id="cat" aria-label="Category"><option value="">Any category</option>{% for c in categories %}<option>{{ c }}</option>{% endfor %}</select>
      <select id="status" aria-label="Status"><option value="">Any status</option><option>new</option><option>baseline</option><option>suppressed</option></select>
      {% set urgent = result.urgent() %}
      <label><input id="backlog" type="checkbox"{% if not urgent %} checked{% endif %}> Show the backlog ({{ result.findings | length - urgent | length }})</label>
    </div>
    <div class="table-wrap">
    <table id="findings">
      <thead><tr><th>Priority</th><th>Finding</th><th>Location</th><th>Tools</th></tr></thead>
      <tbody>
      {% for f in result.findings %}
        <tr class="finding" tabindex="0" aria-expanded="false" data-urgent="{{ '1' if f in urgent else '' }}" data-prio="{{ f.priority.value }}" data-tools="{{ f.sources | join(' ') }}"
            data-cat="{{ f.category.value }}" data-status="{{ f.status.value }}"
            data-text="{{ (f.title ~ ' ' ~ f.rule_id ~ ' ' ~ f.location.path ~ ' ' ~ (f.cwe | join(' ')) ~ ' ' ~ (f.vuln_ids | join(' '))) | lower }}">
          <td><span class="{{ f.priority.value }}">{{ f.priority.value }}</span> <span class="muted">{{ f.risk_score }}</span></td>
          <td>{{ f.title }}
            <div class="flags">
              {% if f.gating %}<b>blocks merge</b> · {% endif %}{% if f.enrichment.kev %}<b>KEV</b> · {% endif %}{{ f.severity.value }}{% if f.enrichment.epss is not none %} · EPSS {{ "%.1f" | format(f.enrichment.epss * 100) }}%{% endif %}{% if f.package and f.package.reachability and f.package.reachability.value == "unused" %} · unused dependency{% elif f.package and f.package.reachability and f.package.reachability.value == "entrypoint" %} · <b>reachable</b>{% endif %}{% for c in f.cwe[:2] %} · {{ c }}{% endfor %}{% if f.ai %} · AI: {{ f.ai.verdict.label }}{% endif %} · {{ f.status.value }}
            </div>
            <code class="mloc">{{ f.location.path }}{% if f.location.start_line %}:{{ f.location.start_line }}{% endif %}</code>
          </td>
          <td class="loc"><code>{{ f.location.path }}{% if f.location.start_line %}:{{ f.location.start_line }}{% endif %}</code></td>
          <td class="muted">{{ f.sources | join(", ") }}</td>
        </tr>
        <tr class="detail" hidden><td colspan="4">
          <dl class="kv">
            <dt>Rule</dt><dd><code>{{ f.tool }}:{{ f.rule_id }}</code>{% for r in f.related_rules %}, <code>{{ r }}</code>{% endfor %}</dd>
            <dt>Why this priority</dt><dd>{{ f.score_reasons | join("; ") }}</dd>
            {% if f.package %}<dt>Package</dt><dd>{{ f.package.name }} {{ f.package.version or "" }}{% if f.package.fixed_version %} → fixed in {{ f.package.fixed_version }}{% endif %}</dd>{% endif %}
            {% if f.package and f.package.reachability %}<dt>Reachability</dt><dd>{{ f.package.reachability.value }}{% if f.package.reach_evidence %} · {{ f.package.reach_evidence | join("; ") }}{% endif %}</dd>{% endif %}
            {% if f.owasp %}<dt>OWASP</dt><dd>{{ f.owasp | join(", ") }}</dd>{% endif %}
            {% if f.suppression_reason %}<dt>Suppressed</dt><dd>{{ f.suppression_reason }}</dd>{% endif %}
            <dt>Fingerprint</dt><dd><code>{{ f.fingerprint }}</code></dd>
          </dl>
          {% if f.description %}<p>{{ f.description }}</p>{% endif %}
          {% if f.location.snippet %}<pre>{{ f.location.snippet }}</pre>{% endif %}
          {% if f.remediation %}<p><strong>Fix:</strong> {{ f.remediation }}</p>{% endif %}
          {% if f.references %}<p>{% for r in f.references[:5] if r.startswith(("https://", "http://")) %}<a href="{{ r }}" rel="noopener noreferrer" target="_blank">{{ r }}</a><br>{% endfor %}</p>{% endif %}
          {% if f.ai %}
          <div class="ai">
            <strong>AI triage: {{ f.ai.verdict.label }}</strong> <span class="muted">({{ f.ai.confidence.value }} confidence)</span>
            {% if f.ai.summary %}<p><em>{{ f.ai.summary }}</em></p>{% endif %}
            <p>{{ f.ai.reasoning }}</p>
            {% if f.ai.remediation %}<p><strong>Suggested fix:</strong> {{ f.ai.remediation }}</p>{% endif %}
            {% if f.ai.fix_code %}<pre>{{ f.ai.fix_code }}</pre>{% endif %}
            <p class="muted">Advisory only: it does not change the gate. Model: {{ f.ai.model }}</p>
          </div>
          {% endif %}
        </td></tr>
      {% else %}
        <tr><td colspan="4" class="muted">No findings.</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>

  {% if ag and ag.exposures %}
  <section class="tab" id="t-exposures">
    <h2>One bug away</h2>
    <p class="lead">No finding today, but a single new bug at these public entry points would reach a high-value asset. This is hardening advice and doesn't affect the gate.</p>
    <ul class="list">{% for x in ag.exposures %}<li><strong>{{ x.entry }}</strong>{% for n in x.via %} → {{ n }}{% endfor %} → <strong>{{ x.target }}</strong><span class="a">A {{ x.needs | join(" or ") | replace("_", " ") }} bug here would do it. Fix: {{ x.harden }}.</span></li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if ag and ag.skipped %}
  <section class="tab" id="t-blind">
    <h2>Blind spots</h2>
    <p class="lead">What breachgraph saw but couldn't analyze. A path through any of these wouldn't show up above.</p>
    <ul class="list">{% for s in ag.skipped %}<li>{{ s }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <section class="tab" id="t-scanners">
    <h2>Scanners</h2>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Scanner</th><th>Status</th><th>Findings</th><th>Duration</th><th>Version or message</th></tr></thead>
      <tbody>
      {% for t in result.tools %}
        <tr><td>{{ t.name }}</td><td>{{ t.status.value }}</td><td class="mono">{{ t.findings }}</td><td class="mono">{{ "%.1fs" | format(t.duration_s) }}</td><td class="muted">{{ t.version or "" }} {{ t.message or "" }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% if result.warnings %}<ul class="list" style="margin-top: var(--s3)">{% for w in result.warnings %}<li>{{ w }}</li>{% endfor %}</ul>{% endif %}
  </section>

  {% if ag and ag.paths %}
  <section class="tab" id="t-text">
    <h2>Paths as text</h2>
    {% for p in ag.paths %}
    <div class="textpath">
      <h3>{{ p.target }}</h3>
      <span class="muted">Risk {{ p.score }} · {{ p.confidence }} confidence{% if p.gating %} · blocks merge{% endif %}{% if p.needs_login %} · needs a login{% endif %}{% if result.baseline_used and not p.is_new %} · pre-existing{% endif %}</span>
      <ol>
        <li>Internet</li>
        {% for s in p.steps %}
        <li>{{ s.dst }}{% if s.via %} <span class="v">needs {{ s.via.replace("_", " ") }}</span>{% endif %}
          {% if s.via and s.weakness_title %}<small>{{ s.weakness_title }}</small>{% endif %}
          {% if s.evidence_path and s.via %}<small><code>{{ s.evidence_path }}{% if s.evidence_line %}:{{ s.evidence_line }}{% endif %}</code></small>{% endif %}
        </li>
        {% endfor %}
      </ol>
      {% if p.techniques %}
      <p class="tags">MITRE ATT&amp;CK: {% for t in p.techniques %}<a href="{{ attack_url(t) }}" title="{{ attack_name(t) }}" rel="noopener">{{ t }}</a> {{ attack_name(t) }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% endif %}
    </div>
    {% endfor %}
    {% if ag.choke_points %}
    <h3 style="margin-top: var(--s4); font-size: 14px">Fix these first: each breaks the most paths</h3>
    <ul class="list">{% for c in ag.choke_points[:6] %}<li>{{ c.title }}{% if c.path %} <code>{{ c.path }}{% if c.line %}:{{ c.line }}{% endif %}</code>{% endif %}<span class="a">Breaks {{ c.paths_cut }} path(s)</span></li>{% endfor %}</ul>
    {% endif %}
  </section>
  {% endif %}
  <footer>Generated by <a href="{{ project_url }}" rel="noopener">breachgraph</a> {{ result.breachgraph_version }}. This file makes no network requests.</footer>
</main>
{% if explorer %}<script type="application/json" id="bg-data">{{ explorer_json }}</script>{% endif %}
<script>
(function () {
  "use strict";
  document.documentElement.classList.add("js");
  var $ = function (id) { return document.getElementById(id); };
