  if (stored()) root.dataset.theme = stored();
  function label() { theme.textContent = isDark() ? "Light" : "Dark"; }
  theme.hidden = false; label();
  theme.addEventListener("click", function () {
    root.dataset.theme = isDark() ? "light" : "dark";
    try { localStorage.setItem("bg-theme", root.dataset.theme); } catch (e) { /* no storage: this page only */ }
    label();
  });

  var copy = $("copy");
  if (copy) copy.addEventListener("click", function () {
    var t = copy.dataset.text;
    function done() { copy.textContent = "Copied"; setTimeout(function () { copy.textContent = t; }, 1400); }
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(done, done); else done();
  });

  /* lower tabs: without JavaScript every section simply shows */
  var tabs = Array.prototype.slice.call(document.querySelectorAll("#tabs button"));
  function openTab(btn) {
    tabs.forEach(function (b) {
      var on = b === btn;
      b.setAttribute("aria-selected", String(on));
      $(b.dataset.tab).hidden = !on;
    });
  }
  $("tabs").hidden = false;
  tabs.forEach(function (b) { b.addEventListener("click", function () { openTab(b); }); });
  openTab(tabs[0]);

  /* findings */
  var rows = Array.prototype.slice.call(document.querySelectorAll("tr.finding"));
  function toggle(r) { var d = r.nextElementSibling; d.hidden = !d.hidden; r.setAttribute("aria-expanded", String(!d.hidden)); }
  rows.forEach(function (r) {
    r.addEventListener("click", function () { toggle(r); });
    r.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(r); } });
  });
  var q = $("q"), sel = ["prio", "tool", "cat", "status"].map($), backlog = $("backlog");
  function apply() {
    var text = q.value.toLowerCase();
    var searching = text || sel.some(function (s) { return s.value; });
    rows.forEach(function (r) {
      var show = (backlog.checked || searching || r.dataset.urgent === "1")
        && (!text || r.dataset.text.indexOf(text) !== -1)
        && (!sel[0].value || r.dataset.prio === sel[0].value)
        && (!sel[1].value || r.dataset.tools.split(" ").indexOf(sel[1].value) !== -1)
        && (!sel[2].value || r.dataset.cat === sel[2].value)
        && (!sel[3].value || r.dataset.status === sel[3].value);
      r.hidden = !show;
      if (!show) r.nextElementSibling.hidden = true;
    });
  }
  q.addEventListener("input", apply);
  backlog.addEventListener("change", apply);
  sel.forEach(function (s) { s.addEventListener("change", apply); });
  apply();

  /* ---------- explorer ---------- */
  var dataEl = $("bg-data");
  if (!dataEl) return;
  var data = JSON.parse(dataEl.textContent);
  if (!data || !data.paths || !data.paths.length) return;
  var SVG = "http://www.w3.org/2000/svg";
  var KIND = { internet: "internet", entrypoint: "entry point", workload: "workload", route: "HTTP route", host: "host",
               image: "image", identity: "identity", datastore: "data store", secret: "secret" };
  var GLYPH = {
    internet: "M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13M1.5 8h13M8 1.5c-3.5 4-3.5 9 0 13M8 1.5c3.5 4 3.5 9 0 13",
    entrypoint: "M3 8h7M7.5 5 10.5 8l-3 3M12.5 2.5v11",
    workload: "M2.5 5 8 2l5.5 3v6L8 14l-5.5-3zM2.5 5 8 8l5.5-3M8 8v6",
    route: "M2 8h9M8.5 5l3 3-3 3M13.5 3.5v9",
    host: "M2.5 3h11v4h-11zM2.5 9h11v4h-11zM5 5h.01M5 11h.01",
    image: "M2.5 3.5h11v9h-11zM2.5 7h11M6 3.5v9",
    identity: "M10.5 2.5a3 3 0 1 0-2.6 4.6L3 12v1.5h2.5V12H7l1.5-1.5v-1l1.3-1.3a3 3 0 0 0 .7-5.7z",
    datastore: "M2.5 4c0-3 11-3 11 0v8c0 3-11 3-11 0zM2.5 4c0 3 11 3 11 0M2.5 8c0 3 11 3 11 0",
    secret: "M4 7V5a4 4 0 0 1 8 0v2M3 7h10v6.5H3zM8 9.5v2"
  };
  var nodes = {}; data.nodes.forEach(function (n) { nodes[n.id] = n; });
  function node(id) { return nodes[id] || { id: id, name: id, kind: "", weaknesses: [], evidence: [], value: 0 }; }
  var jewels = {}; data.paths.forEach(function (p) { jewels[p.nodes[p.nodes.length - 1]] = true; });
  var SEP = "\u0000";

  var edges = {}, edgeList = [];
  data.edges.forEach(function (e) {
    var k = e.src + SEP + e.dst;
    if (!edges[k]) { edges[k] = { key: k, src: e.src, dst: e.dst, requires: [], notes: [], evidence: e.evidence }; edgeList.push(edges[k]); }
    e.requires.forEach(function (r) { if (edges[k].requires.indexOf(r) < 0) edges[k].requires.push(r); });
    if (e.note) edges[k].notes.push(e.note);
  });
  var via = {};
  data.paths.forEach(function (p) {
    p.steps.forEach(function (s, i) { if (s.via) via[p.nodes[i] + SEP + p.nodes[i + 1]] = s.via; });
  });

  /* layout: column = deepest position on any path, rows by barycenter of what leads there */
  var depth = {};
  data.paths.forEach(function (p) { p.nodes.forEach(function (id, i) { depth[id] = Math.max(depth[id] || 0, i); }); });
  var cols = [];
  Object.keys(depth).forEach(function (id) { (cols[depth[id]] = cols[depth[id]] || []).push(id); });
  cols = cols.map(function (c) { return c || []; });
  var order = {};
  cols.forEach(function (c) { c.forEach(function (id, i) { order[id] = i; }); });
  for (var sweep = 0; sweep < 4; sweep++) {
    cols.forEach(function (c, ci) {
      if (!ci) return;
      var bary = {};
      c.forEach(function (id) {
        var ins = edgeList.filter(function (e) { return e.dst === id && depth[e.src] < ci; });
        bary[id] = ins.length ? ins.reduce(function (s, e) { return s + order[e.src]; }, 0) / ins.length : order[id];
      });
      c.sort(function (a, b) { return bary[a] - bary[b]; });
      c.forEach(function (id, i) { order[id] = i; });
    });
  }
  var stage = $("stage"), tip = $("tip");
  var NW = 184, NH = 48, PAD = 48;
  var maxRows = Math.max.apply(null, cols.map(function (c) { return c.length; }));
  // Run the graph along whichever direction lets it be drawn larger in this pane.
  var sw = stage.clientWidth || 700, sh = stage.clientHeight || 500;
  var alongX = (cols.length - 1) * (NW + 84) + NW, acrossX = (maxRows - 1) * (NH + 30) + NH;
  var alongY = (cols.length - 1) * (NH + 58) + NH, acrossY = (maxRows - 1) * (NW + 20) + NW;
  var vertical = Math.min(sw / (acrossY + PAD * 2), sh / (alongY + PAD * 2)) > Math.min(sw / (alongX + PAD * 2), sh / (acrossX + PAD * 2));
  var AX = vertical ? NH + 58 : NW + 84, CR = vertical ? NW + 20 : NH + 30; // along the path, across it
