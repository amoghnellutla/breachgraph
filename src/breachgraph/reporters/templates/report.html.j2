  // Keep a node comfortably in view, moving only when it would leave.
  function follow(id, always) {
    var p = pos[id], w = stage.clientWidth, h = stage.clientHeight, M = 64;
    if (!p) return;
    var x = p.x * cam.k + cam.x, y = p.y * cam.k + cam.y, nw = NW * cam.k, nh = NH * cam.k;
    if (!always && x > M && x + nw < w - M && y > M && y + nh < h - M) return;
    cam.x = w / 2 - (p.x + NW / 2) * cam.k; cam.y = h / 2 - (p.y + NH / 2) * cam.k;
    applyCam(true);
  }
  function zoom(f, cx, cy) {
    var k = Math.max(.3, Math.min(2.5, cam.k * f));
    cx = cx === undefined ? stage.clientWidth / 2 : cx; cy = cy === undefined ? stage.clientHeight / 2 : cy;
    cam.x = cx - (cx - cam.x) * k / cam.k; cam.y = cy - (cy - cam.y) * k / cam.k; cam.k = k;
    applyCam(false);
  }
  $("zoom-in").addEventListener("click", function () { zoom(1.25); });
  $("zoom-out").addEventListener("click", function () { zoom(.8); });
  $("zoom-fit").addEventListener("click", fit);
  stage.addEventListener("wheel", function (ev) {
    if (!ev.ctrlKey && !ev.metaKey) return; // a plain wheel scrolls the page
    ev.preventDefault();
    var r = stage.getBoundingClientRect();
    zoom(ev.deltaY < 0 ? 1.1 : .9, ev.clientX - r.left, ev.clientY - r.top);
  }, { passive: false });
  var drag = null;
  stage.addEventListener("pointerdown", function (ev) {
    if (ev.button !== 0 || ev.target.closest(".node, .hit, .tools")) return;
    drag = { x: ev.clientX - cam.x, y: ev.clientY - cam.y };
    stage.classList.add("drag"); stage.setPointerCapture(ev.pointerId);
  });
  stage.addEventListener("pointermove", function (ev) {
    if (!drag) return;
    cam.x = ev.clientX - drag.x; cam.y = ev.clientY - drag.y; applyCam(false);
  });
  function endDrag() { drag = null; stage.classList.remove("drag"); }
  stage.addEventListener("pointerup", endDrag);
  stage.addEventListener("pointercancel", endDrag);
  var fitTimer;
  window.addEventListener("resize", function () {
    clearTimeout(fitTimer);
    fitTimer = setTimeout(function () { if (cur) frame(cur.nodes); else fit(); }, 120);
  });

  function showTip(ev, title, body) {
    tip.textContent = "";
    tip.appendChild(h("b", "", title));
    if (body) tip.appendChild(document.createTextNode(body));
    var r = stage.getBoundingClientRect();
    tip.style.left = Math.min(ev.clientX - r.left + 14, stage.clientWidth - 290) + "px";
    tip.style.top = Math.min(ev.clientY - r.top + 14, stage.clientHeight - 70) + "px";
    tip.classList.add("on");
  }
  function hideTip() { tip.classList.remove("on"); }
  function words(s) { return s.replace(/_/g, " "); }
  function trunc(s, n) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }

  var edgeEls = {};
  edgeList.forEach(function (e) {
    var a = pos[e.src], b = pos[e.dst];
    if (!a || !b) return;
    var d;
    if (vertical) {
      var x1 = a.x + NW / 2, y1 = a.y + NH, x2 = b.x + NW / 2, y2 = b.y, my = (y1 + y2) / 2;
      d = "M" + x1 + "," + y1 + " C" + x1 + "," + my + " " + x2 + "," + my + " " + x2 + "," + y2;
    } else if (b.x > a.x) {
      var sx = a.x + NW, sy = a.y + NH / 2, ex = b.x, ey = b.y + NH / 2, mx = (sx + ex) / 2;
      d = "M" + sx + "," + sy + " C" + mx + "," + sy + " " + mx + "," + ey + " " + ex + "," + ey;
    } else { // same or earlier column: loop under the cards
      var low = Math.max(a.y, b.y) + NH + 26;
      d = "M" + (a.x + NW / 2) + "," + (a.y + NH) + " C" + (a.x + NW / 2) + "," + low + " " + (b.x + NW / 2) + "," + low + " " + (b.x + NW / 2) + "," + (b.y + NH);
    }
    var v = via[e.key], g = el("g", {}, gEdges);
    var path = el("path", { d: d, class: "edge" + (v ? " weapon" : "") }, g);
    var hit = el("path", { d: d, class: "hit", tabindex: "0", role: "img",
      "aria-label": node(e.src).name + " to " + node(e.dst).name + (v ? ", needs " + words(v) : "") }, g);
    var note = e.notes.join(" · ") + (e.evidence ? " (" + e.evidence + ")" : "");
    var title = v ? "Needs " + words(v) : "Access";
    hit.addEventListener("pointermove", function (ev) { showTip(ev, title, note); });
    hit.addEventListener("pointerleave", hideTip);
    var label = null;
    if (v) {
      var mid = path.getPointAtLength(path.getTotalLength() / 2), t = words(v), w = t.length * 6.4 + 12;
      label = el("g", { class: "lbl" }, gLabels);
      el("rect", { x: mid.x - w / 2, y: mid.y - 9, width: w, height: 18, rx: 3 }, label);
      el("text", { x: mid.x, y: mid.y + 3.5, "text-anchor": "middle" }, label).textContent = t;
    }
    edgeEls[e.key] = { g: g, path: path, label: label };
  });

  var nodeEls = {};
  Object.keys(pos).forEach(function (id) {
    var n = node(id), p = pos[id];
    var g = el("g", { class: "node" + (jewels[id] ? " jewel" : ""), transform: "translate(" + p.x + "," + p.y + ")", tabindex: "0", role: "button",
      "aria-label": (KIND[n.kind] || n.kind) + ": " + n.name + (n.weaknesses.length ? ", " + n.weaknesses.length + " weakness(es)" : "") }, gNodes);
    el("rect", { class: "card", width: NW, height: NH, rx: 6 }, g);
    if (GLYPH[n.kind]) el("path", { class: "glyph", d: GLYPH[n.kind], transform: "translate(12,16)" }, g);
    var kindText = (KIND[n.kind] || n.kind) + (jewels[id] ? ", high value" : "");
    var named = kindText.toLowerCase() !== n.name.toLowerCase();
    el("text", { class: "name", x: 36, y: named ? 21 : 29 }, g).textContent = trunc(n.name, 21);
    if (named) el("text", { class: "kind", x: 36, y: 37 }, g).textContent = kindText;
    if (n.weaknesses.length) el("circle", { class: "dot", cx: NW - 12, cy: 12, r: 3.5 }, g);
    g.addEventListener("pointermove", function (ev) {
      showTip(ev, n.name, n.weaknesses.length ? n.weaknesses[0].title : (KIND[n.kind] || n.kind));
    });
    g.addEventListener("pointerleave", hideTip);
    g.addEventListener("click", function () { inspectNode(id); });
    g.addEventListener("keydown", function (ev) { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); inspectNode(id); } });
    nodeEls[id] = g;
  });

  /* ---------- state ---------- */
  var fixed = {}, cur = null, step = 0, inspecting = null, anim = null;
  function alive(p) { return !p.weaknesses.some(function (fp) { return fixed[fp]; }); }
  function plural(n, s) { return n + " " + s + (n === 1 ? "" : "s"); }

  function draw() {
    var live = data.paths.filter(alive), onLive = {}, edgeLive = {};
    live.forEach(function (p) {
      p.nodes.forEach(function (id, i) { onLive[id] = true; if (i) edgeLive[p.nodes[i - 1] + SEP + id] = true; });
    });
    var inCur = {}, edgeCur = {};
    if (cur) cur.nodes.forEach(function (id, i) { inCur[id] = true; if (i) edgeCur[cur.nodes[i - 1] + SEP + id] = true; });
    Object.keys(nodeEls).forEach(function (id) {
      var g = nodeEls[id];
      g.classList.toggle("gone", !onLive[id] && !inCur[id]);
      g.classList.toggle("dim", !!cur && !inCur[id] && !!onLive[id]);
      g.classList.toggle("on", !!inCur[id]);
      g.classList.toggle("now", !!cur && cur.nodes[step] === id);
      g.classList.toggle("sel", inspecting === id);
    });
    Object.keys(edgeEls).forEach(function (k) {
      var e = edgeEls[k], isCur = !!edgeCur[k], dead = !edgeLive[k];
      e.path.classList.toggle("on", isCur);
      e.path.classList.toggle("cut", isCur && dead);
      [e.g, e.label].forEach(function (x) {
        if (!x) return;
        x.classList.toggle("gone", dead && !isCur);
        x.classList.toggle("dim", !!cur && !isCur && !dead);
      });
    });
    $("counter").textContent = live.length + "/" + data.paths.length;
    var head = $("headline"), sub = $("subhead"), touched = Object.keys(fixed).some(function (k) { return fixed[k]; });
    if (head && touched) {
      head.textContent = "";
      head.classList.toggle("clear", !live.length);
      if (live.length) {
        var open = h("em", "", plural(live.length, "attack path")); head.appendChild(open);
        head.appendChild(document.createTextNode(" still open, " + (data.paths.length - live.length) + " closed by your fixes"));
      } else {
        head.appendChild(h("em", "", "Every attack path is closed"));
        head.appendChild(document.createTextNode(" by your fixes"));
      }
      if (sub) sub.textContent = "This is a preview on this page. breachgraph fix writes the safe ones for you.";
    }
    drawPaths(); drawFixes();
  }

  function drawPaths() {
    var box = $("paths"); box.textContent = "";
    data.paths.forEach(function (p, i) {
      var b = h("button", "row" + (alive(p) ? "" : " closed")); b.type = "button";
      b.setAttribute("aria-pressed", String(cur === p));
      b.appendChild(h("span", "n", String(i + 1)));
      b.appendChild(h("span", "t", p.target));
      var m = h("span", "m");
      if (!alive(p)) m.textContent = "closed by your fix";
      else {
        if (p.gating) { m.appendChild(h("b", "", "blocks")); m.appendChild(document.createTextNode(" · ")); }
        if (p.confidence === "low") m.appendChild(h("span", "low", "low confidence"));
        else m.appendChild(document.createTextNode(p.confidence));
        m.appendChild(document.createTextNode(" · " + plural(p.steps.length, "step") + (p.needs_login ? " · needs a login" : "")));
      }
      b.appendChild(m);
      var at = p.steps.map(function (s) { return s.via; }).indexOf(p.steps.filter(function (s) { return s.via; }).map(function (s) { return s.via; })[0]);
      if (at >= 0) b.appendChild(h("span", "m", words(p.steps[at].via) + " at " + node(p.nodes[at]).name));
      b.addEventListener("click", function () { selectPath(p, true); });
      box.appendChild(b);
    });
  }

  function drawFixes() {
    var box = $("fixes"); box.textContent = "";
    if (!data.fixes.length) return;
    box.appendChild(h("div", "divider"));
    box.appendChild(h("div", "panelabel", "Fix first"));
    data.fixes.forEach(function (f) {
      var lab = h("label", "fix"), cb = h("input"); cb.type = "checkbox"; cb.checked = !!fixed[f.fingerprint];
      cb.addEventListener("change", function () { setFixed(f.fingerprint, cb.checked); });
      lab.appendChild(cb);
      lab.appendChild(h("span", "t", f.title.replace(/`/g, "")));
      var m = h("span", "m", "Breaks " + plural(f.paths_cut, "path"));
      lab.appendChild(m);
      if (f.at) lab.appendChild(h("code", "", f.at));
      box.appendChild(lab);
    });
  }

  function setFixed(fp, on) { stop(); fixed[fp] = on; draw(); if (inspecting) drawNode(inspecting); else drawTrace(); }

  function drawTrace() {
    var pane = $("inspector"); pane.textContent = "";
    if (!cur) return;
    var head = h("div", "tracehead");
    head.appendChild(h("h3", "", cur.target));
    var open = alive(cur);
    head.appendChild(h("div", "m", "Risk " + Math.round(cur.score * 10) / 10 + " · " + cur.confidence + " confidence" + (cur.gating ? " · blocks merge" : "") + (cur.needs_login ? " · needs a login" : "")));
    var ctrls = h("div", "ctrls");
    var prev = h("button", "ctl", "←"), next = h("button", "ctl", "→"), play = h("button", "ctl", "Replay");
    prev.type = next.type = play.type = "button";
    prev.setAttribute("aria-label", "Previous step"); next.setAttribute("aria-label", "Next step");
    prev.disabled = step <= 0; next.disabled = step >= cur.nodes.length - 1;
    prev.addEventListener("click", function () { go(step - 1); });
    next.addEventListener("click", function () { go(step + 1); });
    play.addEventListener("click", replay);
    ctrls.appendChild(prev); ctrls.appendChild(next); ctrls.appendChild(play);
    var hint = h("span", "hint"); hint.appendChild(h("kbd", "", "↑↓")); hint.appendChild(document.createTextNode(" path "));
    hint.appendChild(h("kbd", "", "←→")); hint.appendChild(document.createTextNode(" step"));
    ctrls.appendChild(hint);
    head.appendChild(ctrls);
    pane.appendChild(head);

    var scroll = h("div", "scroll"), trace = h("div", "trace");
    if (!open) trace.appendChild(h("p", "closednote", "Closed: your fix breaks this path."));
    var list = h("ol"); list.style.cssText = "list-style:none;margin:0;padding:0";
    cur.nodes.forEach(function (id, i) {
      var n = node(id), s = i ? cur.steps[i - 1] : null, last = i === cur.nodes.length - 1, nextStep = cur.steps[i];
      var li = h("li", "hop" + (last ? " jewel" : "") + (nextStep && nextStep.via ? " vuln" : "") + (i < step ? " arrived" : "") + (i === step ? " now" : ""));
      li.appendChild(h("div", "h", n.name));
      if ((KIND[n.kind] || n.kind).toLowerCase() !== n.name.toLowerCase()) {
        li.appendChild(h("div", "k", (KIND[n.kind] || n.kind) + (last ? ", high value" : "")));
      }
      if (s && s.note) li.appendChild(h("div", "how", s.note.replace(/`/g, "")));
      if (s && s.via) {
        var fp = n && cur.weaknesses[0], fixedHere = cur.weaknesses.some(function (w) { return fixed[w]; });
        var w = h("div", "weak" + (fixedHere ? " done" : ""));
        w.appendChild(h("div", "c", (fixedHere ? "Fixed: " : "Needs ") + words(s.via)));
        if (s.title) w.appendChild(h("div", "", s.title.replace(/`/g, "")));
        if (s.at) w.appendChild(h("code", "", s.at));
        li.appendChild(w);
        if (fp) {
          var b = h("button", "act", fixedHere ? "Undo" : "Mark as fixed"); b.type = "button";
          b.addEventListener("click", function (ev) {
            ev.stopPropagation();
            cur.weaknesses.forEach(function (x) { setFlag(x, !fixedHere); });
            draw(); drawTrace();
          });
          li.appendChild(b);
        }
      }
      if (s && s.techniques && s.techniques.length) {
        var tags = h("div", "tags");
        s.techniques.forEach(function (t, ti) {
          if (ti) tags.appendChild(document.createTextNode(" · "));
          var a = h("a", "", t); a.rel = "noopener"; a.target = "_blank";
          a.href = "https://attack.mitre.org/techniques/" + t.replace(".", "/") + "/";
          a.addEventListener("click", function (ev) { ev.stopPropagation(); });
          tags.appendChild(a);
        });
        li.appendChild(tags);
      }
      li.addEventListener("click", function () { go(i); });
      list.appendChild(li);
    });
    trace.appendChild(list); scroll.appendChild(trace); pane.appendChild(scroll);
  }
  function setFlag(fp, on) { stop(); fixed[fp] = on; }

  function drawNode(id) {
    var n = node(id), pane = $("inspector"); pane.textContent = "";
    var head = h("div", "tracehead");
    head.appendChild(h("h3", "", n.name));
    head.appendChild(h("div", "m", (KIND[n.kind] || n.kind) + (jewels[id] ? ", high value" : "") + (n.value ? " · value " + n.value + "/10" : "")));
    var back = h("button", "ctl", "← Back to the path"); back.type = "button";
    back.addEventListener("click", function () { inspecting = null; draw(); drawTrace(); });
    var ctrls = h("div", "ctrls"); ctrls.appendChild(back); head.appendChild(ctrls);
    pane.appendChild(head);
    var scroll = h("div", "scroll"), box = h("div", "trace info");
    if (n.evidence.length) {
      var dl = h("dl"); dl.appendChild(h("dt", "", "Defined in")); dl.appendChild(h("dd", "", n.evidence.join(", ")));
      box.appendChild(dl);
    }
    if (n.weaknesses.length) {
      box.appendChild(h("h4", "", "Weaknesses"));
      n.weaknesses.forEach(function (w) {
        var on = w.fingerprint && fixed[w.fingerprint], d = h("div", "weak" + (on ? " done" : ""));
        d.appendChild(h("div", "c", words(w.cls)));
        d.appendChild(h("div", "", w.title));
        if (w.location) d.appendChild(h("code", "", w.location));
        box.appendChild(d);
        if (w.fingerprint && data.paths.some(function (p) { return p.weaknesses.indexOf(w.fingerprint) >= 0; })) {
          var b = h("button", "act", on ? "Undo" : "Mark as fixed"); b.type = "button";
          b.addEventListener("click", function () { setFixed(w.fingerprint, !on); });
          box.appendChild(b);
        }
      });
    }
    [["Reached from", edgeList.filter(function (e) { return e.dst === id; }), "src"],
     ["Leads to", edgeList.filter(function (e) { return e.src === id; }), "dst"]].forEach(function (spec) {
      if (!spec[1].length) return;
      box.appendChild(h("h4", "", spec[0]));
      var ul = h("ul");
      spec[1].forEach(function (e) {
        var li = h("li", "", node(e[spec[2]]).name + (e.requires.length ? ", needs " + words(e.requires.join(" or ")) : ""));
        if (e.notes.length) li.appendChild(h("div", "muted", e.notes[0]));
        ul.appendChild(li);
      });
      box.appendChild(ul);
    });
    scroll.appendChild(box); pane.appendChild(scroll);
  }

  function selectPath(p, animate) {
    stop(); inspecting = null; cur = p; step = 0; draw(); drawTrace(); frame(p.nodes);
    if (animate) replay();
  }
  function inspectNode(id) { stop(); inspecting = inspecting === id ? null : id; draw(); if (inspecting) drawNode(id); else drawTrace(); }
  function go(i) {
    if (!cur) return;
    stop(); step = Math.max(0, Math.min(cur.nodes.length - 1, i)); inspecting = null;
    var e = i > 0 ? edgeEls[cur.nodes[step - 1] + SEP + cur.nodes[step]] : null;
    if (e && motion) {
      var pt = e.path.getPointAtLength(e.path.getTotalLength());
      runner.setAttribute("cx", pt.x); runner.setAttribute("cy", pt.y);
    }
    follow(cur.nodes[step]);
    draw(); drawTrace();
  }

  /* replay: a marker walks the path, one hop at a time, and the trace follows it */
  function stop() { if (anim) { cancelAnimationFrame(anim); anim = null; } runner.classList.add("idle"); }
  function replay() {
    stop();
    if (!cur) return;
    var p = cur;
    if (!motion) { go(p.nodes.length - 1); return; }
    runner.classList.remove("idle");
    var i = 0, t0 = null, HOP = 620, PAUSE = 240;
    step = 0; draw(); drawTrace();
    function frame(ts) {
      if (t0 === null) t0 = ts;
      var e = edgeEls[p.nodes[i] + SEP + p.nodes[i + 1]], t = Math.min(1, (ts - t0) / HOP);
      if (e) {
        var eased = 1 - Math.pow(1 - t, 3), len = e.path.getTotalLength(), pt = e.path.getPointAtLength(len * eased);
        runner.setAttribute("cx", pt.x); runner.setAttribute("cy", pt.y);
      }
      if (t >= 1) {
        if (ts - t0 < HOP + PAUSE) {
          if (step !== i + 1) { step = i + 1; follow(p.nodes[step]); draw(); drawTrace(); }
          anim = requestAnimationFrame(frame); return;
        }
        i += 1; t0 = ts;
        if (i >= p.nodes.length - 1) { anim = null; runner.classList.add("idle"); return; }
      }
      anim = requestAnimationFrame(frame);
    }
    anim = requestAnimationFrame(frame);
  }

  document.addEventListener("keydown", function (ev) {
    if (/INPUT|SELECT|TEXTAREA/.test(ev.target.tagName) || ev.metaKey || ev.ctrlKey || !cur) return;
    var i = data.paths.indexOf(cur);
    if (ev.key === "ArrowRight") { ev.preventDefault(); go(step + 1); }
    else if (ev.key === "ArrowLeft") { ev.preventDefault(); go(step - 1); }
    else if (ev.key === "ArrowDown" && benchInView()) { ev.preventDefault(); selectPath(data.paths[(i + 1) % data.paths.length], false); }
    else if (ev.key === "ArrowUp" && benchInView()) { ev.preventDefault(); selectPath(data.paths[(i + data.paths.length - 1) % data.paths.length], false); }
    else if (ev.key === "r") replay();
    else if (ev.key === "Escape") { inspecting = null; stop(); draw(); drawTrace(); }
  });
  function benchInView() { var r = $("explorer").getBoundingClientRect(); return r.top < innerHeight * .6 && r.bottom > innerHeight * .4; }

  $("explorer").hidden = false;
  fit();
  selectPath(data.paths[0], false);
  /* play the first path once, when it first comes into view */
  if (motion && "IntersectionObserver" in window) {
    var seen = new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { seen.disconnect(); setTimeout(function () { if (cur === data.paths[0] && step === 0) replay(); }, 500); }
    }, { threshold: .4 });
    seen.observe($("explorer"));
  }
})();
</script>
</body>
</html>
